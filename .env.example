# ==============================================================================
# Campus Lost & Found Smart Portal - Environment Configuration Template
# Copy this file to '.env' and populate with your own secret values.
# NEVER commit the actual '.env' file containing real secrets to GitHub!
# ==============================================================================

# Django Secret Key (Generate a random 50+ character string in production)
SECRET_KEY=your-secret-key-here

# Debug Mode (True for local development, False in production)
DEBUG=True

# Allowed Hosts (Comma-separated list of domains or IP addresses)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CSRF Trusted Origins (Comma-separated URLs permitted to submit POST requests)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com

# Time Zone (e.g. Asia/Kolkata, UTC, America/New_York)
TIME_ZONE=Asia/Kolkata

# Database URL (Optional: Defaults to local SQLite db.sqlite3 if omitted)
# For Render PostgreSQL: postgres://username:password@hostname:5432/dbname
# DATABASE_URL=postgres://user:password@dpg-xxxx.render.com/campus_db

# HTTPS Redirection (Optional: Set to True if forcing HTTPS redirect in production)
SECURE_SSL_REDIRECT=False
